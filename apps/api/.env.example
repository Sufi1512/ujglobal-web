ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ujglobal
CORS_ORIGINS=["http://localhost:3000"]
IP_HASH_SALT=change-me
# Admin auth. Outside local development JWT_SECRET must be a random value of 32+ characters
# (for example `openssl rand -hex 32`); the API refuses to start otherwise.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Plain-HTTP local development only; keep true anywhere served over HTTPS.
COOKIE_SECURE=false
# Background jobs and email (local: Redis and Mailpit from compose.yml; open http://localhost:8025).
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
EMAIL_FROM=UJ Global <no-reply@ujglobal.tech>
LEAD_ALERT_RECIPIENTS=["team@ujglobal.tech"]
ADMIN_BASE_URL=http://localhost:3000
# Ask the Next.js site to refresh cached pages after content edits (shared secret with apps/web).
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-only-revalidate-secret
