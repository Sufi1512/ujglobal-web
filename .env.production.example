# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# UJ Global, LIVE SITE settings, used by `docker compose up` (compose.yml).
# Copy to .env.production next to compose.yml and fill it in. Never commit the real file (git ignores it).
# ─────────────────────────────────────────────────────────────────────────────────────────────────────

# Your domain, with https. The website and its API both live here.
SITE_URL=https://ujglobal.tech

# ── Database: your existing PostgreSQL (13 or newer) ──
# Required, no default: the site's own user and database. The API creates the database on start if it
# doesn't exist yet, and refuses to start without this setting.
# PostgreSQL on this same server: use host.docker.internal as the host.
DATABASE_URL=postgresql+asyncpg://ujglobal:CHANGE_ME_DB_PASSWORD@host.docker.internal:5432/ujglobal

# Optional: an admin connection (e.g. the postgres superuser). When set, the API also creates the user
# above (with that password) if it doesn't exist. Leave empty if you created the user yourself, or if the
# user above may create databases (CREATEDB).
DATABASE_ADMIN_URL=

# ── Secrets: run `bash infra/server/gen-secrets.sh` and paste its four lines here ──
# Keep MFA_ENCRYPTION_KEY the same forever: changing it turns everyone's two-factor sign-in off.
JWT_SECRET=
IP_HASH_SALT=
REVALIDATE_SECRET=
MFA_ENCRYPTION_KEY=

# ── Email for contact-form alerts ──
# Every message from the contact form is saved in the admin Leads inbox and emailed to
# LEAD_ALERT_RECIPIENTS; replying to the alert answers the visitor directly.
# Not ready yet? Set LEAD_ALERT_RECIPIENTS=[] and the site starts without email settings.
#
# Replace SMTP_HOST and SMTP_PASSWORD for the service that hosts hello@ujglobal.tech:
#   Google Workspace   SMTP_HOST=smtp.gmail.com        SMTP_PORT=587  SMTP_SECURITY=starttls
#                      SMTP_PASSWORD = an App Password (Google Account > Security > 2-Step Verification > App passwords)
#   Zoho Mail          SMTP_HOST=smtp.zoho.com         SMTP_PORT=587  SMTP_SECURITY=starttls
#                      (smtppro.zoho.com on paid plans; smtp.zoho.eu / smtp.zoho.in if your account is there)
#   Hostinger          SMTP_HOST=smtp.hostinger.com    SMTP_PORT=465  SMTP_SECURITY=tls
#   Microsoft 365      SMTP_HOST=smtp.office365.com    SMTP_PORT=587  SMTP_SECURITY=starttls
#   Resend             SMTP_HOST=smtp.resend.com       SMTP_PORT=587  SMTP_SECURITY=starttls
#                      SMTP_USERNAME=resend  SMTP_PASSWORD = your Resend API key
# Port 465 needs SMTP_SECURITY=tls; port 587 needs starttls. With your own mailbox (Google, Zoho,
# Hostinger, Microsoft) keep EMAIL_FROM as the same address you log in with.
SMTP_HOST=REPLACE_smtp_server
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=hello@ujglobal.tech
SMTP_PASSWORD=REPLACE_password_or_app_password
EMAIL_FROM=UJ Global <hello@ujglobal.tech>
LEAD_ALERT_RECIPIENTS=["hello@ujglobal.tech"]

# ── The one port your hosting panel points the domain at ──
PUBLIC_PORT=9005
# 127.0.0.1 = only this server can connect (safe default). 0.0.0.0 only if your panel connects from
# another machine; then allow the port from the panel's address alone.
PUBLIC_BIND=127.0.0.1

# ── Optional: Cloudflare Turnstile ("are you human" check) on the contact form ──
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
