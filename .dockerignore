# For the live images built from the repository root (infra/single-port/*.Dockerfile).
# .env is deliberately NOT ignored: the live images read the site's settings from it.
.git
**/node_modules
**/.next
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/dump.rdb
.env.local
apps/web/.env*
apps/api/.env*
