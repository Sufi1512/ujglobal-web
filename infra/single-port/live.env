# Defaults for the live single-port stack, built into the API image (infra/single-port/api.Dockerfile).
# The .env next to compose.yml overrides these, and real environment variables override both.
ENVIRONMENT=production
REDIS_URL=redis://redis:6379/0
WEB_REVALIDATE_URL=http://web:9006/api/revalidate
COOKIE_SECURE=true
