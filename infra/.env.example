# Template for /srv/ujglobal/.env on the server. Never commit the real file.
ENVIRONMENT=production
IMAGE_TAG=latest

POSTGRES_USER=ujglobal
POSTGRES_PASSWORD=
POSTGRES_DB=ujglobal
DATABASE_URL=postgresql+asyncpg://ujglobal:CHANGE_ME@postgres:5432/ujglobal

CORS_ORIGINS=["https://ujglobal.tech"]
# Random values, for example `openssl rand -hex 32`. The API will not start with the defaults.
IP_HASH_SALT=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=true

# Background jobs and email. Use the SMTP details from Resend (smtp.resend.com, user "resend", password =
# API key) or Postmark (smtp.postmarkapp.com, user and password = server token). Port 587 with starttls.
REDIS_URL=redis://redis:6379/0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Must be on a domain verified with the email provider (SPF and DKIM on Cloudflare).
EMAIL_FROM=UJ Global <no-reply@ujglobal.tech>
LEAD_ALERT_RECIPIENTS=["you@ujglobal.tech"]
ADMIN_BASE_URL=https://ujglobal.tech
