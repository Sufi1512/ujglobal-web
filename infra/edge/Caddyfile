# Routes every UJ Global domain to its stack on the `ujglobal-edge` network.
# Cloudflare sits in front (SSL mode "Full (strict)"); Caddy presents Cloudflare's origin certificate,
# which covers ujglobal.tech and *.ujglobal.tech, so there is no certificate renewal to fail.
# Environment (from /srv/ujglobal/edge/.env): STAGING_USER and STAGING_PASSWORD_HASH (`caddy hash-password`).

{
	# No automatic certificates: the origin certificate below is used for every site.
	auto_https disable_certs
	servers {
		# Cloudflare connects from its own addresses; trust its forwarded headers.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(origin_tls) {
	tls /certs/origin.pem /certs/origin.key
}

(common) {
	import origin_tls
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# --- Production ---------------------------------------------------------------------------------------

ujglobal.tech {
	import common
	reverse_proxy production-web:3000
}

www.ujglobal.tech {
	import origin_tls
	redir https://ujglobal.tech{uri} permanent
}

api.ujglobal.tech {
	import common
	reverse_proxy production-api:8000
}

# --- Staging: password-protected, never indexed ------------------------------------------------------

staging.ujglobal.tech {
	import common
	header X-Robots-Tag "noindex, nofollow"
	# The revalidation endpoint is called by the staging worker inside Docker, never through here.
	basic_auth {
		{$STAGING_USER} {$STAGING_PASSWORD_HASH}
	}
	reverse_proxy staging-web:3000
}

# The staging API stays open so the staging site can call it from the browser (a password prompt would
# break those requests). It only ever holds test data, and it is never indexed.
api-staging.ujglobal.tech {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy staging-api:8000
}

# Anything else (an IP address, an unknown name): close the connection.
:443 {
	import origin_tls
	abort
}

http:// {
	redir https://{host}{uri} permanent
}
