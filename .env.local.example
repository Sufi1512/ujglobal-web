# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# UJ Global, LOCAL DEVELOPMENT settings, used by `docker compose -f compose.dev.yml up` (compose.dev.yml).
# Copy to .env.local. The values below are safe test values and work as they are.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────

# Where you open the site and the API in your browser.
SITE_URL=http://localhost:9006
API_URL=http://localhost:9005

# Ports on your computer (only reachable from it).
WEB_PORT=9006
API_PORT=9005
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# The local database server (a container started by compose.dev.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Required: the database the site uses. It's created automatically if it doesn't exist.
# "postgres" is the container's name; from tools on your computer use localhost:5433 instead.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ujglobal

# Test-only secret shared by the API worker and the website.
REVALIDATE_SECRET=dev-only-revalidate-secret

# Where new-lead alerts go: they land in the local test inbox at http://localhost:8025.
LEAD_ALERT_RECIPIENTS=["team@ujglobal.tech"]

# Roles that must use two-factor sign-in. [] skips it locally; ["owner","sales"] matches the live site.
MFA_REQUIRED_ROLES=[]
