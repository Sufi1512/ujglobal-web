# Settings for the live site (compose.yml). Copy to `.env` next to compose.yml, or enter them in your
# hosting panel's environment settings. Never commit the real values.

# Your domain, with https. The site and its API both live here.
SITE_URL=https://ujglobal.tech

# Your existing PostgreSQL (13 or newer). Create an empty database and user for the site first
# (docs/DEPLOY-SINGLE-PORT.md, step 1). If PostgreSQL runs on this same server, use host.docker.internal.
DATABASE_URL=postgresql+asyncpg://ujglobal:CHANGE_ME@host.docker.internal:5432/ujglobal

# Random secrets: run infra/server/gen-secrets.sh and paste its four lines here.
JWT_SECRET=
IP_HASH_SALT=
REVALIDATE_SECRET=
MFA_ENCRYPTION_KEY=

# Email for new-lead alerts (Resend or Postmark). Required unless LEAD_ALERT_RECIPIENTS=[].
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_SECURITY=starttls
EMAIL_FROM=UJ Global <no-reply@ujglobal.tech>
LEAD_ALERT_RECIPIENTS=["you@ujglobal.tech"]

# The port your hosting panel points the domain at (default 9005), and who may connect to it:
# 127.0.0.1 = only this server (safe default); 0.0.0.0 only if the panel connects over the network.
PUBLIC_PORT=9005
PUBLIC_BIND=127.0.0.1

# Optional: Cloudflare Turnstile on the contact form (both keys from the Cloudflare dashboard).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
